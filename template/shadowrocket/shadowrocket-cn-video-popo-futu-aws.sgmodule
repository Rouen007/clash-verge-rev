#!name=手机分流-默认PROXY
#!desc=国内视频/常用国内服务、网易POPO及Apple常规服务直连；Google/OpenAI/Claude/GitHub/Telegram/LINE、Apple Push/Relay、Copilot与Futu走当前PROXY；其余未匹配流量默认PROXY。不包含节点或订阅凭据。

[Rule]
# sub.conf 基础直连规则：本地/私有地址与邮件端口直连
GEOIP,PRIVATE,DIRECT,no-resolve
DST-PORT,25,DIRECT
DST-PORT,110,DIRECT
DST-PORT,143,DIRECT
DST-PORT,465,DIRECT
DST-PORT,587,DIRECT
DST-PORT,993,DIRECT
DST-PORT,995,DIRECT

# 网络连通性检测域名：走当前 PROXY
DOMAIN-SUFFIX,browserleaks.com,PROXY
DOMAIN-SUFFIX,ipleak.net,PROXY
DOMAIN-SUFFIX,dnsleaktest.com,PROXY


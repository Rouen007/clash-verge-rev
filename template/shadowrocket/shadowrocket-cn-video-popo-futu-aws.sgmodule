#!name=国内视频与POPO直连-Futu走AWS
#!desc=仅添加分流规则，不替换现有Config或节点。国内视频与网易POPO直连；Futu相关域名走AWS-Singapore-SS443。

[Rule]
# Futu / 富途：走本机已添加的 AWS 新加坡节点
DOMAIN-SUFFIX,futunn.com,AWS-Singapore-SS443
DOMAIN-SUFFIX,futu5.com,AWS-Singapore-SS443
DOMAIN-SUFFIX,futuhk.com,AWS-Singapore-SS443
DOMAIN-SUFFIX,futuholdings.com,AWS-Singapore-SS443
DOMAIN-SUFFIX,futu.com,AWS-Singapore-SS443

# 网易 POPO：网易域名直连；未涵盖的 App 后端可按 Shadowrocket 日志补齐
DOMAIN-SUFFIX,netease.com,DIRECT
DOMAIN-SUFFIX,netease.im,DIRECT


#!name=手机分流-默认PROXY
#!desc=国内视频、网易POPO及中国IP直连；Futu与其余未匹配流量走当前PROXY策略。不包含节点或订阅凭据。

[Rule]
# sub.conf 基础直连规则：本地/私有地址与邮件端口直连
GEOIP,PRIVATE,DIRECT,no-resolve
DST-PORT,25,DIRECT
DST-PORT,110,DIRECT
DST-PORT,143,DIRECT
DST-PORT,465,DIRECT
DST-PORT,587,DIRECT
DST-PORT,993,DIRECT
DST-PORT,995,DIRECT

# 网络连通性检测域名：走当前 PROXY
DOMAIN-SUFFIX,browserleaks.com,PROXY
DOMAIN-SUFFIX,ipleak.net,PROXY
DOMAIN-SUFFIX,dnsleaktest.com,PROXY

# Futu / 富途：走 Shadowrocket 当前选择的 PROXY 策略，不绑定特定节点
DOMAIN-SUFFIX,futunn.com,PROXY
DOMAIN-SUFFIX,futu5.com,PROXY
DOMAIN-SUFFIX,futuhk.com,PROXY
DOMAIN-SUFFIX,futuholdings.com,PROXY
DOMAIN-SUFFIX,futu.com,PROXY

# 网易 POPO：网易域名直连；未涵盖的 App 后端可按 Shadowrocket 日志补齐
DOMAIN-SUFFIX,netease.com,DIRECT
DOMAIN-SUFFIX,netease.im,DIRECT

# 国内视频网站：按常见官方服务域名直连
DOMAIN-SUFFIX,bilibili.com,DIRECT
DOMAIN-SUFFIX,biliapi.net,DIRECT
DOMAIN-SUFFIX,bilivideo.com,DIRECT
DOMAIN-SUFFIX,bilivideo.cn,DIRECT
DOMAIN-SUFFIX,hdslb.com,DIRECT
DOMAIN-SUFFIX,douyu.com,DIRECT
DOMAIN-SUFFIX,douyucdn.cn,DIRECT
DOMAIN-SUFFIX,gov.cn,DIRECT
DOMAIN-SUFFIX,gov,DIRECT

DOMAIN-SUFFIX,iqiyi.com,DIRECT
DOMAIN-SUFFIX,qiyi.com,DIRECT
DOMAIN-SUFFIX,iqiyipic.com,DIRECT
DOMAIN-SUFFIX,qiyipic.com,DIRECT
DOMAIN-SUFFIX,pps.tv,DIRECT
DOMAIN-SUFFIX,ppsimg.com,DIRECT
DOMAIN-SUFFIX,71.am,DIRECT
DOMAIN-SUFFIX,71edge.com,DIRECT
DOMAIN-SUFFIX,71edge.net,DIRECT

DOMAIN-SUFFIX,v.qq.com,DIRECT
DOMAIN-SUFFIX,video.qq.com,DIRECT
DOMAIN-SUFFIX,qqvideo.gtimg.com,DIRECT
DOMAIN-SUFFIX,v.smtcdns.com,DIRECT

DOMAIN-SUFFIX,youku.com,DIRECT
DOMAIN-SUFFIX,ykimg.com,DIRECT
DOMAIN-SUFFIX,tudou.com,DIRECT
DOMAIN-SUFFIX,soku.com,DIRECT

DOMAIN-SUFFIX,mgtv.com,DIRECT
DOMAIN-SUFFIX,hitv.com,DIRECT
DOMAIN-SUFFIX,cctv.com,DIRECT
DOMAIN-SUFFIX,cntv.cn,DIRECT

# 中国 IP 直连；未命中其他规则的流量默认走当前 PROXY
GEOIP,CN,DIRECT
FINAL,PROXY
